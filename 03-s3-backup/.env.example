# AWS S3 Backup Automator — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── AWS ──────────────────────────────────────────────────
# S3 bucket to upload backups to
AWS_S3_BUCKET=your-backup-bucket-name

# AWS region (default: ap-south-1 for Mumbai)
AWS_REGION=ap-south-1

# S3 prefix/folder inside the bucket
AWS_S3_PREFIX=backups

# AWS credentials (only needed if NOT using IAM roles)
# On EC2 with an IAM role attached, leave these blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Slack ─────────────────────────────────────────────────
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Backup Options ─────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
